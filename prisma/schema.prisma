generator client {
  provider               = "prisma-client"
  output                 = "./generated"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// Enums — all @map'd to lowercase strings so existing JSON seeds
// and runtime comparisons keep working without changes.
// ----------------------------------------------------

enum Role {
  ADMIN  @map("admin")
  AUTHOR @map("author")
  USER   @map("user")
}

enum ActivityType {
  WORKSHOP    @map("Workshop")
  CHALLENGE   @map("Challenge")
  MASTERCLASS @map("Masterclass")
  PANEL       @map("Panel")
}

enum ActivityStatus {
  OPEN   @map("open")
  FULL   @map("full")
  CLOSED @map("closed")
}

enum ProductCategory {
  ROBOTICS     @map("Robotics")
  KNOWLEDGE    @map("Knowledge")
  IOT          @map("IoT")
  MECHATRONICS @map("Mechatronics")
}

enum KnowledgeCategory {
  ROBOTICS         @map("Robotics")
  MECHANICS        @map("Mechanics")
  ENGINEERING      @map("Engineering")
  AI_And_Vision    @map("AI & Vision")
  IoT_And_Hardware @map("IoT & Hardware")
  PROGRAMMING      @map("Programming")
  GENERAL          @map("General")
}

enum KnowledgeStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  REJECTED  @map("rejected")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?   @db.Text // Base64 encoded profile image or URL
  tagline       String?
  bio           String?   @db.Text
  role          Role      @default(USER) // Role enum: admin | author | user
  passwordHash  String?   @map("password_hash") // bcrypt hash for credentials login
  timeline      Json      @default("[]") // Array of objects: [{ id, startYear, endYear, title, institution, description, order }]
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @updatedAt @map(name: "updated_at")
  accounts      Account[]
  sessions      Session[]

  @@index([createdAt])
  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ----------------------------------------------------
// Expanded Domain Models for New MechGirl STEM Website
// ----------------------------------------------------

model Activity {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  type          ActivityType   @default(WORKSHOP) // Workshop, Challenge, Masterclass, Panel
  date          String
  time          String?
  location      String?
  description   String
  content       String?        @db.Text
  image         String?
  seats         Int            @default(0)
  registered    Int            @default(0)
  status        ActivityStatus @default(OPEN) // open, full, closed
  featured      Boolean        @default(false)
  tags          String[]       @default([]) // free-form tags, mirrors Product.tags / Knowledge.tags
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  registrations Registration[]

  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("activities")
}

model Registration {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  address    String?
  notes      String?
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([activityId])
  @@index([email])
  @@index([createdAt])
  @@map("registrations")
}

model Product {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  category    ProductCategory @default(ROBOTICS) // Robotics, Knowledge, IoT, Mechatronics
  description String
  content     String?         @db.Text
  image       String?
  github      String?
  demo        String?
  tags        String[]        @default([])
  featured    Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured])
  @@index([createdAt])
  @@map("products")
}

model CarouselSlide {
  id        String   @id @default(cuid())
  src       String
  alt       String?
  title     String?
  subtitle  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, order])
  @@map("carousel_slides")
}

model ContactInfo {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  email     String
  phone     String?
  address   String?
  about     String?  @db.Text
  facebook  String?
  youtube   String?
  github    String?
  instagram String?
  linkedin  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_info")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([read])
  @@index([createdAt])
  @@map("contact_messages")
}

model Knowledge {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  category    KnowledgeCategory @default(ENGINEERING) // Robotics, Mechanics, Engineering, AI & Vision, IoT & Hardware, Programming, General
  summary     String?           @db.Text
  content     String            @db.Text
  image       String?           @db.Text
  status      KnowledgeStatus   @default(PENDING) // pending | confirmed | rejected
  confirmed   Boolean           @default(false)
  authorId    String?           @map("author_id")
  authorName  String?           @map("author_name")
  authorEmail String?           @map("author_email")
  authorImage String?           @map("author_image")
  tags        String[]          @default([])
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([authorId])
  @@index([confirmed])
  @@map("common_knowledge")
}
