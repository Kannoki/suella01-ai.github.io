generator client {
  provider               = "prisma-client"
  output                 = "./generated"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String  @id @default(cuid())
  title     String
  content   String?
  published Boolean @default(false)
  author    User?   @relation(fields: [authorId], references: [id])
  authorId  String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?   @db.Text // Base64 encoded profile image or URL
  tagline       String?
  bio           String?   @db.Text
  role          String    @default("user") // "admin" | "author" | "user"
  timeline      Json      @default("[]") // Array of objects: [{ id, startYear, endYear, title, institution, description, order }]
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @updatedAt @map(name: "updated_at")
  posts         Post[]
  accounts      Account[]
  sessions      Session[]

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ----------------------------------------------------
// Expanded Domain Models for New MechGirl STEM Website
// ----------------------------------------------------

model Activity {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  type          String         @default("Workshop") // Workshop, Challenge, Masterclass, Panel
  date          String
  time          String?
  location      String?
  description   String
  content       String?        @db.Text
  image         String?
  seats         Int            @default(0)
  registered    Int            @default(0)
  status        String         @default("open") // open, full, closed
  featured      Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  registrations Registration[]

  @@map("activities")
}

model Registration {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  address    String?
  notes      String?
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("registrations")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   @default("Robotics") // Robotics, Knowledge, IoT, Mechatronics
  description String
  content     String?  @db.Text
  image       String?
  github      String?
  demo        String?
  tags        String[] @default([])
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model CarouselSlide {
  id        String   @id @default(cuid())
  src       String
  alt       String?
  title     String?
  subtitle  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carousel_slides")
}

model ContactInfo {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  email     String
  phone     String?
  address   String?
  about     String?  @db.Text
  facebook  String?
  youtube   String?
  github    String?
  instagram String?
  linkedin  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_info")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
