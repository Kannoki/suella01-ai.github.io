{
  "name": "mechgirl-stem-portal",
  "version": "1.0.0",
  "description": "MechGirl STEM Portal - Empowering Women in Mechanics, Robotics & STEM",
  "keywords": [
    "nextjs",
    "prisma",
    "postgresql",
    "nextauth",
    "stem",
    "robotics"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-prep.js",
    "dev": "next",
    "prebuild": "node scripts/dev-prep.js --build",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/swagger-ui-react": "^5.18.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "dompurify": "^3.1.6",
    "framer-motion": "^13.2.0",
    "isomorphic-dompurify": "^2.36.0",
    "next": "13.5.11",
    "next-auth": "4.24.15",
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "8.0.7",
    "swagger-ui-react": "^5.32.14",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/next-auth": "3.15.0",
    "@types/node": "16.18.126",
    "@types/pg": "^8.23.1",
    "@types/react": "17.0.93",
    "dotenv": "^17.2.3",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "string-replace-loader": "^3.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
