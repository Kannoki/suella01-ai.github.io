# ── Copy this file to .env on your VPS and fill in real values ────────────────
# ⚠️  NEVER commit real secrets to git. Use a secrets manager in production.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mechgirl

# ── Next.js + NextAuth ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change_me_strong_password@postgres:5432/mechgirl
NEXTAUTH_URL=https://yourdomain.com
# 32+ char random secret for JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_32_char_secret_string
# Optional secondary admin key accepted by lib/auth.ts as a Bearer token
ADMIN_API_KEY=replace_with_random_64_char_hex
# One-time bootstrap password for first admin creation. Remove after first login.
ADMIN_BOOTSTRAP_PASSWORD=replace_with_random_24_char_password

# ── OAuth Providers (NextAuth) ─────────────────────────────────────────────────
GITHUB_ID=
GITHUB_SECRET=
