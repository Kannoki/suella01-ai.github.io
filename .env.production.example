# ── Copy this file to .env on your VPS, fill in real values ────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mechgirl

# Next.js + NextAuth
DATABASE_URL=postgresql://postgres:change_me_strong_password@postgres:5432/mechgirl
SECRET=replace_with_random_32_char_secret_string!
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=replace_with_random_32_char_secret_string!

# GitHub OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=

# Admin
ADMIN_PASSWORD=mechgirl-admin-2026
