# ─────────────────────────────────────────────────────────────────────────────
# Production Environment Variables for MechGirl STEM Portal
# Copy this file to `.env` on your production server or paste into Vercel/Render.
# ⚠️  NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (Public — exposed to the browser) ────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC45sfHg486IiYTcEFEY_FXq4j2m53Xzlc"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="test-noffication.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="test-noffication"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="test-noffication.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="571960662294"
NEXT_PUBLIC_FIREBASE_APP_ID="1:571960662294:web:59fae39b9ba730793c5837"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MPXPS1ZCBF"

# ── Firebase Admin SDK (SERVER ONLY — Never expose to browser) ────────────────
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID="test-noffication"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@test-noffication.iam.gserviceaccount.com"
# Private key with escaped newlines (e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...").
# In Vercel, paste the exact multiline value or keep \n escaped.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Canonical production URL of your app (e.g. https://yourdomain.com)
NEXTAUTH_URL="https://yourdomain.com"

# 32+ char random string for JWT session signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_random_32_char_secret_string"

# Optional fallback secret
SECRET=""

# ── API Authentication ────────────────────────────────────────────────────────
# Admin API key for header-based auth (Bearer / x-admin-key / admin_token cookie)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="replace_with_random_64_char_hex"

# One-time bootstrap password used only on initial deployment to register
# or claim the first admin account via /api/auth/login.
# Remove after first admin account is created.
ADMIN_BOOTSTRAP_PASSWORD="replace_with_strong_temporary_bootstrap_password"

# ── OAuth Providers (Optional) ────────────────────────────────────────────────
GITHUB_ID=""
GITHUB_SECRET=""
