# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for MechGirl STEM Portal
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit real secrets. Use a secrets manager in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (public — safe to expose to the browser) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC45sfHg486IiYTcEFEY_FXq4j2m53Xzlc"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="test-noffication.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="test-noffication"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="test-noffication.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="571960662294"
NEXT_PUBLIC_FIREBASE_APP_ID="1:571960662294:web:59fae39b9ba730793c5837"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MPXPS1ZCBF"

# ── Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ─────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID="test-noffication"
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Paste the private key value from the downloaded JSON (keep \n escape sequences)
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Canonical URL of the site (used by NextAuth for callbacks and redirects)
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED. 32+ char random string used to sign JWT session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional fallback for the above (used by lib/auth.ts as a secondary admin key)
SECRET=""

# ── API Authentication ────────────────────────────────────────────────────────
# Separate admin key for header-based auth (Bearer / x-admin-key / admin_token cookie).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=""

# Optional: a one-time bootstrap password used only on a brand-new database
# (when no user rows exist) to create the first admin account via /api/auth/login.
# After the admin account is created, this variable can be removed from the environment.
ADMIN_BOOTSTRAP_PASSWORD=""

# ── OAuth Providers (NextAuth) ─────────────────────────────────────────────────
# GitHub OAuth — leave blank to disable
GITHUB_ID=""
GITHUB_SECRET=""
