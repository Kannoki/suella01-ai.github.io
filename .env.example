# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for MechGirl STEM Portal
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit real secrets. Use a secrets manager in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Prisma supports the native connection string format for PostgreSQL.
# See https://pris.ly/d/connection-strings for all options.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mechgirl"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Canonical URL of the site (used by NextAuth for callbacks and redirects)
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED. 32+ char random string used to sign JWT session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional fallback for the above (used by lib/auth.ts as a secondary admin key)
SECRET=""

# ── API Authentication ────────────────────────────────────────────────────────
# Separate admin key for header-based auth (Bearer / x-admin-key / admin_token cookie).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=""

# Optional: a one-time bootstrap password used only on a brand-new database
# (when no user rows exist) to create the first admin account via /api/auth/login.
# After the admin account is created, this variable can be removed from the environment.
ADMIN_BOOTSTRAP_PASSWORD=""

# ── OAuth Providers (NextAuth) ─────────────────────────────────────────────────
# GitHub OAuth — leave blank to disable
GITHUB_ID=""
GITHUB_SECRET=""

# ── Docker Compose overrides (passed via shell env to docker-compose.yml) ──────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mechgirl
