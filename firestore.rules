rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Activities (public read, admin write) ────────────────────────────────
    match /activities/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Registrations (auth users can register; only admin reads/deletes) ────
    match /registrations/{id} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }

    // ── Products / Projects (public read, admin write) ───────────────────────
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Hero Carousel (public read, admin write) ─────────────────────────────
    match /carousel_slides/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Common Knowledge / Blogs ─────────────────────────────────────────────
    // Public: only confirmed articles
    // Authenticated: create (submit for review)
    // Admin: full access including moderation
    match /knowledge/{id} {
      allow read: if resource.data.confirmed == true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Contact Info (singleton doc keyed "main") ────────────────────────────
    match /contact_info/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Contact Messages (anyone can submit; only admin reads) ───────────────
    match /contact_messages/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Users can read/write their own document; admins can access all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // ── Site Stats — visitor counter & presence ──────────────────────────────
    // site_stats/global holds { totalVisits } — public increment allowed.
    match /site_stats/{document} {
      allow read: if true;
      allow write: if true;
    }

    // site_stats_presence holds ephemeral session docs keyed by random UUID.
    // No sensitive data — anyone can write/delete their own presence doc.
    match /site_stats_presence/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Helper: isAdmin ──────────────────────────────────────────────────────

    // Checks the requesting user's role field in their users/{uid} document
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
